{
  "version": "v1",
  "hooks": [
    {
      "name": "to guarantee critical graduation artifacts on agent stop",
      "trigger": "Stop",
      "action": {
        "type": "command",
        "command": "if [ -f senzing-bootcamp/scripts/ensure_graduation_artifacts.py ]; then python3 senzing-bootcamp/scripts/ensure_graduation_artifacts.py --stop-hook; fi"
      },
      "timeout": 180
    }
  ]
}
